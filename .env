# Practica_MLOPS — configuración local
# Este archivo contiene valores de desarrollo, no credenciales reales.
# NO subas .env a Git. Para producción, configura los secretos en el proveedor cloud.

# --- Aplicación / API ---
APP_ENV=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
PUBLIC_URL=http://127.0.0.1:8000

# --- Persistencia ---
# Dejar DATABASE_URL vacío para usar SQLite local.
DATABASE_URL=
SQLITE_PATH=storage/mlops.sqlite3
DB_CONNECT_TIMEOUT_S=5

# Ejemplo PostgreSQL (reemplazar con credenciales reales fuera del repositorio):
# DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:5432/mlops

# --- Caché ---
# Sin URL/token de Upstash se utiliza únicamente la caché LRU local.
UPSTASH_REDIS_REST_URL="https://peaceful-moose-322622.upstash.io"
UPSTASH_REDIS_REST_TOKEN="gQAAAAAABOw-AAIgcDJiMDM4M2IyMWQ4MTY0MzhlOGZmZTU2YTk0ZjdkYmYzZQ"CACHE_TTL_S=300
CACHE_MAX_ITEMS=2048
CACHE_PREFIX=mlops:

# --- Monitoreo y simulador ---
# En desarrollo se habilita el simulador; usa false para datos reales o producción.
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_S=2.0
METRICS_WINDOW=50
METRICS_HISTORY=500
WARMUP_EVENTS=30

# --- Exportaciones y análisis ---
STATIC_EXPORTS=true
ANALISIS_PRECALCULAR=true

# --- CORS ---
# Nota: la versión original del proyecto configura CORS con comodín en api/main.py.
# Esta variable es documentación para una futura corrección; no se aplica hasta
# implementar su lectura en api/main.py.
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
